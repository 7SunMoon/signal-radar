# Optional: enables real LLM deep review. OpenAI-compatible third-party APIs are supported.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_API_STYLE=auto
OPENAI_STRUCTURED_OUTPUT=auto
OPENAI_ENABLE_THINKING=
OPENAI_REASONING_EFFORT=
LLM_PROVIDER=auto
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_CONSECUTIVE_FAILURE_LIMIT=2

# Optional: enables Brave web search. RSS and Hacker News still run without it.
BRAVE_SEARCH_API_KEY=

# Pipeline tuning
REQUEST_TIMEOUT_SECONDS=15
USER_AGENT=SignalRadar/0.1 (+personal research tool)
RADAR_TIMEZONE=Asia/Shanghai
